{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "examination.schema.json",
  "title": "examination",
  "type": "object",
  "properties": {
    "exam_id": {
      "type": "string",
      "pattern": "^EXAM_[A-Z0-9_]+$"
    },
    "title": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "N5",
        "N4",
        "N3",
        "N2",
        "N1"
      ]
    },
    "exam_type": {
      "enum": [
        "mock",
        "historical",
        "official_sample",
        "custom",
        "past_exam"
      ]
    },
    "source_type": {
      "enum": [
        "OFFICIAL",
        "PRIMARY",
        "EDUCATIONAL",
        "SUPPLEMENTARY",
        "AI_GENERATED",
        "USER_CREATED",
        "COMMUNITY_KEY",
        "AI_ANSWERED"
      ]
    },
    "is_official": {
      "type": "boolean"
    },
    "duration_minutes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "duration_minutes": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "section_id",
          "name"
        ]
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_origin": {
      "enum": [
        "official_seikai",
        "community",
        "ai_consensus"
      ]
    }
  },
  "required": [
    "exam_id",
    "title",
    "level",
    "exam_type",
    "source_type",
    "is_official",
    "sections"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "AI_GENERATED"
          }
        }
      },
      "then": {
        "properties": {
          "is_official": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "enum": [
              "COMMUNITY_KEY",
              "AI_ANSWERED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "is_official": {
            "const": false
          },
          "exam_type": {
            "const": "past_exam"
          }
        }
      }
    }
  ]
}
