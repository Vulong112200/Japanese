{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "title": "question",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^Q_[A-Z0-9_]+$"
    },
    "exam_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "section": {
      "enum": [
        "vocabulary",
        "grammar_reading",
        "grammar",
        "reading",
        "listening"
      ]
    },
    "mondai_type": {
      "type": "string"
    },
    "question_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "passage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "option_id": {
            "type": "string"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "image_asset_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "option_id"
        ],
        "anyOf": [
          {
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "image_asset_id"
            ]
          }
        ]
      }
    },
    "correct_answer": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "answer_type": {
      "enum": [
        "single_choice",
        "multiple_choice",
        "fill_blank",
        "sentence_ordering",
        "sentence_composition"
      ]
    },
    "audio_asset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_asset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "verification_status": {
      "enum": [
        "raw",
        "extracted",
        "normalized",
        "needs_review",
        "verified",
        "rejected"
      ]
    }
  },
  "required": [
    "question_id",
    "section",
    "options",
    "correct_answer",
    "answer_type",
    "source_ids",
    "verification_status"
  ]
}